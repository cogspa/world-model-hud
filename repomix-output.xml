import React from "react";

export default function IntroOverlay({ onClose, agentCount }) {
    return (
        <div id="intro-overlay">
            <div id="intro-card">
                <h2>World Model Guide</h2>
                <p className="intro-subtitle">
                    How to interpret the simulation and spot "Hallucinations".
                </p>

                <div className="intro-section">
                    <h3>When is it "Hallucinating"?</h3>
                    <p>
                        <strong>Hallucination</strong> happens when the AI's internal belief (Agents) diverges from Reality (Mouse).
                        <br />
                        <em>Visual Sign:</em> In <strong>Error Heatmap</strong> mode, the particles turn <strong>RED</strong>.
                    </p>
                </div>

                <div className="intro-section">
                    <h3>Control Recipes</h3>
                    <ul>
                        <li>
                            <strong>The "Good" Model (Locked In)</strong>
                            <br />
                            <span style={{ color: "#4ade80" }}>High Obs Weight + Low Noise.</span>
                            <br />
                            The agents tightly track the sensor. The model trusts what it sees more than what it imagines.
                        </li>
                        <li style={{ marginTop: "8px" }}>
                            <strong>The "Dreaming" Model (Hallucinating)</strong>
                            <br />
                            <span style={{ color: "#f87171" }}>Low Obs Weight + High Noise.</span>
                            <br />
                            The agents ignore the sensor and follow their own internal dynamics (swirls). This is "creativity" or "confusion" depending on context.
                        </li>
                        <li style={{ marginTop: "8px" }}>
                            <strong>The "Amnesiac" Model</strong>
                            <br />
                            <span style={{ color: "#60a5fa" }}>Low Memory.</span>
                            <br />
                            Trails vanish instantly. The model has no sense of history or momentum.
                        </li>
                    </ul>
                </div>

                <div className="intro-section">
                    <h3>Visual Modes</h3>
                    <ul>
                        <li><strong>Standard:</strong> See the raw density of beliefs.</li>
                        <li><strong>Multiverse:</strong> See conflicting predictions (colors = different directions).</li>
                        <li><strong>Error Heatmap:</strong> Green = Accurate, Red = Hallucinating.</li>
                    </ul>
                </div>

                <button id="intro-close" onClick={onClose}>Got it</button>
            </div>
        </div>
    );
}
