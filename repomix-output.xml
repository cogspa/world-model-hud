  margin-bottom: 10px;
}

.wm-modal-header h2 {
  font-size: 14px;
  margin: 0;
}

.wm-modal-close {
  background: transparent;
  border: none;
  color: rgba(255, 255, 255, 0.7);
  font-size: 18px;
  cursor: pointer;
  line-height: 1;
}

/* Controls Container */
.wm-controls {
  position: fixed;
  left: 24px;
  top: 24px;
  width: 280px;
  padding: 16px 18px;
  background: rgba(15, 18, 22, 0.6);
  backdrop-filter: blur(8px);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #cfd7df;
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 14px;
  line-height: 1.3;
  z-index: 50;
}

.wm-controls-title {
  font-weight: 700;
  margin-bottom: 12px;
  font-size: 15px;
  color: #fff;
}

.wm-control-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
  font-size: 13px;
}

.wm-control-group {
  margin-bottom: 12px;
}

.wm-control-group label {
  display: block;
  margin-bottom: 6px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
}

.wm-control-group input[type="range"] {
  width: 100%;
  cursor: pointer;
  accent-color: #2997ff;
}

.wm-controls-footer {
  margin-top: 16px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
}


.intro-subtitle {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 20px;
  line-height: 1.4;
}

.intro-section {
  margin-bottom: 16px;
}

.intro-section h3 {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #2997ff;
  margin-bottom: 4px;
  margin-top: 0;
}

.intro-section p {
  margin: 0;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.intro-section ul {
  margin: 0;
  padding-left: 18px;
  color: rgba(255, 255, 255, 0.9);
}

.intro-section li {
  margin-bottom: 4px;
  font-size: 13px;
}

/* Intro Overlay */
#intro-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

#intro-card {
  max-width: 500px;
  background: #11151b;
  border-radius: 16px;
  padding: 24px 28px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

#intro-card h2 {
  margin-top: 0;
  margin-bottom: 8px;
  font-size: 20px;
  color: #fff;
}


#intro-card h3 {
  margin-bottom: 0.25rem;
  margin-top: 1rem;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  opacity: 0.8;
  color: #fff;
}

#intro-card ul {
  padding-left: 18px;
  margin-top: 0.25rem;
}

#intro-card li {
  margin-bottom: 0.25rem;
}

#intro-close {
  margin-top: 1rem;
  padding: 8px 16px;
  border-radius: 999px;
  border: none;
  background: #f2c14f;
  color: #11151b;
  font-weight: 600;
  cursor: pointer;
  font-size: 14px;
  transition: transform 0.1s;
}

#intro-close:hover {
  transform: scale(1.05);
}

#intro-help-button {
  position: fixed;
  bottom: 24px;
  left: 24px;
  width: 32px;
  height: 32px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(20, 24, 30, 0.9);
  color: #f5f5f5;
  cursor: pointer;
  font-weight: 600;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  transition: background 0.2s;
}

#intro-help-button:hover {
  background: rgba(40, 44, 50, 1);
}

/* Story HUD (Bottom Center) */
.wm-story-hud {
  position: fixed;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  width: min(600px, 90vw);
  padding: 16px 24px;
  background: rgba(15, 18, 22, 0.85);
  backdrop-filter: blur(12px);
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #e2e8f0;
  font-family: system-ui, -apple-system, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  text-align: center;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  z-index: 40;
  transition: all 0.3s ease;
}

.wm-story-hud strong {
  font-weight: 600;
}

/* Technical Panel */
.wm-technical-panel {
  position: fixed;
  right: 24px;
  top: 360px;
  /* Below the HUD */
  width: 320px;
  max-height: calc(100vh - 400px);
  overflow-y: auto;
  background: rgba(10, 12, 16, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 16px;
  color: #cbd5e1;
  font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
  font-size: 12px;
  z-index: 45;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.wm-tech-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding-bottom: 8px;
}

.wm-tech-header h3 {
  margin: 0;
  font-size: 14px;
  color: #fff;
  font-family: system-ui, sans-serif;
  font-weight: 600;
}

.wm-tech-header button {
  background: none;
  border: none;
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  padding: 0 4px;
}

.wm-tech-section {
  margin-bottom: 20px;
}

.wm-tech-section h4 {
  margin: 0 0 8px 0;
  color: #94a3b8;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.wm-tech-section p {
  margin: 0;
  line-height: 1.5;
  color: #94a3b8;
}

.wm-tech-section ul {
  padding-left: 16px;
  margin: 8px 0 0 0;
}

.wm-tech-section li {
  margin-bottom: 8px;
  line-height: 1.4;
}

.wm-equation {
  background: rgba(0, 0, 0, 0.3);
  padding: 10px;
  border-radius: 6px;
  margin-bottom: 8px;
  font-family: 'Times New Roman', serif;
  font-style: italic;
  font-size: 15px;
  text-align: center;
}

.wm-eq-row {
  margin-bottom: 4px;
}

.wm-equation .var {
  color: #fff;
}

.wm-equation .param {
  color: #60a5fa;
  font-family: monospace;
  font-style: normal;
  font-size: 12px;
}

.wm-equation .func {
  color: #f472b6;
  font-family: monospace;
  font-style: normal;
  font-size: 12px;
}

.wm-code-block {
  background: #0f172a;
  padding: 10px;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  margin: 0;
  font-size: 11px;
  line-height: 1.4;
  color: #a5b4fc;
  white-space: pre-wrap;
}
